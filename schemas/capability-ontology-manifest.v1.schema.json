{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/capability-ontology-manifest.v1.schema.json",
  "title": "Manafold Census M4 Capability Ontology Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ontology_schema",
    "build_profile",
    "m3_analysis_manifest_sha256",
    "m3_analysis_schema",
    "m2_requirement_schema",
    "m2_bundle_schema",
    "m4_dimension_registry_version",
    "parent_m4_manifest_sha256",
    "requirement_set_digest",
    "capability_file",
    "review_file",
    "relation_file",
    "admissibility_file",
    "evolution_file",
    "link_shards",
    "mapping_decision_shards"
  ],
  "properties": {
    "schema": {"const": "census.m4-ontology-manifest.v1"},
    "ontology_schema": {"const": "census.capability-ontology.v1"},
    "build_profile": {"const": "census.m4-reference.v1"},
    "m3_analysis_manifest_sha256": {"$ref": "#/$defs/digest"},
    "m3_analysis_schema": {"const": "census.card-analysis.v1"},
    "m2_requirement_schema": {"const": "census.semantic-requirement.v1"},
    "m2_bundle_schema": {
      "const": "census.semantic-requirement-bundle.v1"
    },
    "m4_dimension_registry_version": {"const": "1"},
    "parent_m4_manifest_sha256": {
      "anyOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]
    },
    "requirement_set_digest": {"$ref": "#/$defs/digest"},
    "capability_file": {
      "allOf": [
        {"$ref": "#/$defs/file_descriptor"},
        {"properties": {"relative_path": {"const": "capabilities.jsonl"}}}
      ]
    },
    "review_file": {
      "allOf": [
        {"$ref": "#/$defs/file_descriptor"},
        {"properties": {"relative_path": {"const": "review-authority.jsonl"}}}
      ]
    },
    "relation_file": {
      "allOf": [
        {"$ref": "#/$defs/file_descriptor"},
        {"properties": {"relative_path": {"const": "capability-relations.jsonl"}}}
      ]
    },
    "admissibility_file": {
      "allOf": [
        {"$ref": "#/$defs/file_descriptor"},
        {"properties": {"relative_path": {"const": "requirement-admissibility.jsonl"}}}
      ]
    },
    "evolution_file": {
      "allOf": [
        {"$ref": "#/$defs/file_descriptor"},
        {"properties": {"relative_path": {"const": "evolution.jsonl"}}}
      ]
    },
    "link_shards": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/0.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/1.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/2.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/3.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/4.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/5.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/6.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/7.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/8.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/9.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/a.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/b.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/c.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/d.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/e.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "links/f.jsonl"}}}]}
      ],
      "items": false
    },
    "mapping_decision_shards": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/0.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/1.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/2.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/3.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/4.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/5.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/6.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/7.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/8.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/9.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/a.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/b.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/c.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/d.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/e.jsonl"}}}]},
        {"allOf": [{"$ref": "#/$defs/file_descriptor"}, {"properties": {"relative_path": {"const": "mapping-decisions/f.jsonl"}}}]}
      ],
      "items": false
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "byte_length",
        "record_count"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^(capabilities|review-authority|capability-relations|requirement-admissibility|evolution)\\.jsonl$|^(links|mapping-decisions)/[0-9a-f]\\.jsonl$"
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
