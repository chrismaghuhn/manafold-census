{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/source-lock.v1.schema.json",
  "title": "Census SourceLock v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifacts"],
  "properties": {
    "schema": {"const": "census.source-lock.v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    }
  },
  "$defs": {
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "source_id",
        "locator",
        "sha256",
        "byte_length",
        "media_type"
      ],
      "properties": {
        "schema": {"const": "census.source-artifact.v1"},
        "source_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/_-]*$"
        },
        "locator": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
        }
      }
    }
  }
}
