{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/oracle-record-index-manifest.v1.schema.json",
  "title": "Census Oracle Record Index Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "shards", "aggregate_digest"],
  "properties": {
    "schema": {"const": "census.oracle-record-index-manifest.v1"},
    "shards": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relative_path", "sha256", "byte_length", "record_count"],
        "properties": {
          "relative_path": {
            "type": "string",
            "pattern": "^records/[0-9a-f]\\.jsonl$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "byte_length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "record_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          }
        }
      }
    },
    "aggregate_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
