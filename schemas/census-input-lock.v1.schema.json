{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/census-input-lock.v1.schema.json",
  "title": "Manafold Census M5 CensusInputLock V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lock_version",
    "source_lock_digest",
    "source_lock_file_sha256",
    "m1_structural_manifest_sha256",
    "m1_structural_aggregate_digest",
    "m3_analysis_manifest_sha256",
    "m3_record_identity_set_digest",
    "m3_record_index_digest",
    "m3_trace_index_digest",
    "expected_m4_requirement_set_digest",
    "m1_structural_schema",
    "m3_analysis_schema",
    "m2_requirement_schema",
    "m2_bundle_schema",
    "m4_ontology_schema",
    "m4_dimension_registry_version",
    "expected_oracle_identity_count",
    "expected_structural_record_count",
    "expected_analysis_record_count",
    "expected_requirements_produced_card_count",
    "expected_no_requirements_applicable_count",
    "expected_unresolved_analysis_count",
    "expected_requirement_count"
  ],
  "properties": {
    "schema": {
      "const": "census.census-input-lock.v1"
    },
    "lock_version": {
      "const": 1
    },
    "source_lock_digest": {
      "$ref": "#/$defs/digest"
    },
    "source_lock_file_sha256": {
      "$ref": "#/$defs/digest"
    },
    "m1_structural_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "m1_structural_aggregate_digest": {
      "$ref": "#/$defs/digest"
    },
    "m3_analysis_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "m3_record_identity_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "m3_record_index_digest": {
      "$ref": "#/$defs/digest"
    },
    "m3_trace_index_digest": {
      "$ref": "#/$defs/digest"
    },
    "expected_m4_requirement_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "m1_structural_schema": {
      "const": "census.structural-card.v1"
    },
    "m3_analysis_schema": {
      "const": "census.card-analysis.v1"
    },
    "m2_requirement_schema": {
      "const": "census.semantic-requirement.v1"
    },
    "m2_bundle_schema": {
      "const": "census.semantic-requirement-bundle.v1"
    },
    "m4_ontology_schema": {
      "const": "census.capability-ontology.v1"
    },
    "m4_dimension_registry_version": {
      "const": "1"
    },
    "expected_oracle_identity_count": {
      "$ref": "#/$defs/count"
    },
    "expected_structural_record_count": {
      "$ref": "#/$defs/count"
    },
    "expected_analysis_record_count": {
      "$ref": "#/$defs/count"
    },
    "expected_requirements_produced_card_count": {
      "$ref": "#/$defs/count"
    },
    "expected_no_requirements_applicable_count": {
      "$ref": "#/$defs/count"
    },
    "expected_unresolved_analysis_count": {
      "$ref": "#/$defs/count"
    },
    "expected_requirement_count": {
      "$ref": "#/$defs/count"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    }
  }
}
