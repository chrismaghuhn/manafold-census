{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/census-m4-authority-package.v1.schema.json",
  "title": "Manafold Census M5 Reviewed M4 Authority Package V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "campaign_id",
    "m3_analysis_manifest_sha256",
    "m4_requirement_set_digest",
    "selected_requirement_ids",
    "record_file_descriptors",
    "review_policy",
    "authority_package_digest"
  ],
  "properties": {
    "schema": {
      "const": "census.m5-m4-authority-package.v1"
    },
    "campaign_id": {
      "type": "string",
      "minLength": 1
    },
    "m3_analysis_manifest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "m4_requirement_set_digest": {
      "$ref": "#/$defs/digest"
    },
    "selected_requirement_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requirement_id"
      }
    },
    "record_file_descriptors": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/descriptor"
      }
    },
    "review_policy": {
      "$ref": "#/$defs/review_policy"
    },
    "authority_package_digest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^srq_[0-9a-f]{64}$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "sha256",
        "byte_length",
        "record_count"
      ],
      "properties": {
        "relative_path": {
          "enum": [
            "capability-definitions.jsonl",
            "capability-relations.jsonl",
            "evolution.jsonl",
            "links.jsonl",
            "mapping-decisions.jsonl",
            "requirement-admissibility.jsonl",
            "review-authority.jsonl"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "record_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "review_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sra_authority_id",
        "sra_authority_version",
        "sra_reviewer_id",
        "capability_review_authority_id",
        "capability_review_authority_version",
        "capability_reviewer_id",
        "sra_multiplicity",
        "mapping_multiplicity"
      ],
      "properties": {
        "sra_authority_id": {
          "type": "string",
          "minLength": 1
        },
        "sra_authority_version": {
          "type": "string",
          "minLength": 1
        },
        "sra_reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_review_authority_id": {
          "type": "string",
          "minLength": 1
        },
        "capability_review_authority_version": {
          "type": "string",
          "minLength": 1
        },
        "capability_reviewer_id": {
          "type": "string",
          "minLength": 1
        },
        "sra_multiplicity": {
          "const": "EXACTLY_ONE_PER_SELECTED_REQUIREMENT"
        },
        "mapping_multiplicity": {
          "const": "ONE_PER_SELECTED_REQUIREMENT"
        }
      }
    }
  }
}
