{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/card-analysis.v1.schema.json",
  "title": "Manafold Census Card Analysis V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "outcome",
    "bundle",
    "no_requirements_basis"
  ],
  "properties": {
    "schema": {
      "const": "census.card-analysis.v1"
    },
    "source": {
      "$ref": "https://manafold-census.invalid/schemas/semantic-requirement.v1.schema.json#/$defs/source"
    },
    "outcome": {
      "enum": [
        "REQUIREMENTS_PRODUCED",
        "NO_REQUIREMENTS_APPLICABLE",
        "UNRESOLVED_ANALYSIS"
      ]
    },
    "bundle": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "https://manafold-census.invalid/schemas/semantic-requirement-bundle.v1.schema.json"
        }
      ]
    },
    "no_requirements_basis": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/negative_authority_reference"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "REQUIREMENTS_PRODUCED"
          }
        }
      },
      "then": {
        "properties": {
          "bundle": {
            "type": "object"
          },
          "no_requirements_basis": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "NO_REQUIREMENTS_APPLICABLE"
          }
        }
      },
      "then": {
        "properties": {
          "bundle": {
            "type": "null"
          },
          "no_requirements_basis": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "UNRESOLVED_ANALYSIS"
          }
        }
      },
      "then": {
        "properties": {
          "no_requirements_basis": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "negative_authority_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_id",
        "authority_version",
        "record_id",
        "record_sha256",
        "scope_digest"
      ],
      "properties": {
        "authority_id": {
          "$ref": "#/$defs/identifier"
        },
        "authority_version": {
          "$ref": "#/$defs/identifier"
        },
        "record_id": {
          "type": "string",
          "pattern": "^nra_[0-9a-f]{64}$"
        },
        "record_sha256": {
          "$ref": "#/$defs/digest"
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
