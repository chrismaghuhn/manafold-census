{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/study-spec.v1.schema.json",
  "title": "Census StudySpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "study_id",
    "dataset_refs",
    "operation",
    "parameters"
  ],
  "properties": {
    "schema": {"const": "census.study-spec.v1"},
    "study_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/_-]*$"
    },
    "dataset_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/_-]*$"
      }
    },
    "operation": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/_-]*$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {
          "type": "integer",
          "minimum": -9223372036854775808,
          "maximum": 9223372036854775807
        },
        {"type": "string"},
        {
          "type": "array",
          "items": {"$ref": "#/$defs/jsonValue"}
        },
        {
          "type": "object",
          "propertyNames": {"type": "string"},
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    }
  }
}
