{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://manafold-census.invalid/schemas/capability-claim.v1.schema.json",
  "title": "Manafold Census M4 Capability Claim V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_schema",
    "family_key",
    "capability_version",
    "m2_requirement_schema",
    "m2_interpretation_version",
    "m4_dimension_registry_version",
    "dimensions",
    "exclusions",
    "composition"
  ],
  "properties": {
    "claim_schema": {
      "const": "census.capability-claim.v1"
    },
    "family_key": {
      "$ref": "#/$defs/family_key"
    },
    "capability_version": {
      "$ref": "#/$defs/positive_integer"
    },
    "m2_requirement_schema": {
      "const": "census.semantic-requirement.v1"
    },
    "m2_interpretation_version": {
      "$ref": "#/$defs/text"
    },
    "m4_dimension_registry_version": {
      "$ref": "#/$defs/text"
    },
    "dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dimension"
      }
    },
    "exclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exclusion"
      }
    },
    "composition": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/composition"
        }
      ]
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "positive_integer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "family": {
      "type": "string",
      "enum": [
        "effect",
        "event",
        "choice",
        "cost",
        "control",
        "reference",
        "unknown"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "move_between_zones",
        "create_object",
        "select",
        "modify_characteristic",
        "apply_continuous_effect",
        "search_zone",
        "draw_cards",
        "deal_damage",
        "create_delayed_effect",
        "trigger_from_event",
        "replace_event",
        "pay_cost",
        "modify_cost",
        "choose_mode",
        "conditional_effect",
        "keyword_reference",
        "unresolved"
      ]
    },
    "family_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_key_schema",
        "nucleus_contract_version",
        "nucleus_kind",
        "operation_anchor"
      ],
      "properties": {
        "family_key_schema": {
          "const": "census.capability-family-key.v1"
        },
        "nucleus_contract_version": {
          "$ref": "#/$defs/text"
        },
        "nucleus_kind": {
          "enum": [
            "ATOMIC",
            "COMPOSITE"
          ]
        },
        "operation_anchor": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "kind"
            ],
            "properties": {
              "family": {
                "$ref": "#/$defs/family"
              },
              "kind": {
                "$ref": "#/$defs/kind"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "oneOf": [
            {
              "properties": {
                "nucleus_kind": {
                  "const": "ATOMIC"
                },
                "operation_anchor": {
                  "maxItems": 1
                }
              }
            },
            {
              "properties": {
                "nucleus_kind": {
                  "const": "COMPOSITE"
                },
                "operation_anchor": {
                  "minItems": 2
                }
              }
            }
          ]
        }
      ]
    },
    "path_key": {
      "type": "string",
      "enum": [
        "DRAW_CARDS_DRAWER",
        "DRAW_CARDS_QUANTITY",
        "MOVE_BETWEEN_ZONES_SUBJECT",
        "MOVE_BETWEEN_ZONES_FROM_ZONE",
        "MOVE_BETWEEN_ZONES_TO_ZONE",
        "MOVE_BETWEEN_ZONES_QUANTITY",
        "MOVE_BETWEEN_ZONES_CAUSE",
        "CREATE_OBJECT_OBJECT_CLASS",
        "CREATE_OBJECT_QUANTITY",
        "CREATE_OBJECT_DURATION",
        "SELECT_CHOOSER",
        "SELECT_SUBJECT_KIND",
        "SELECT_QUANTITY",
        "SELECT_RESTRICTION",
        "SELECT_TARGETING",
        "MODIFY_CHARACTERISTIC_SUBJECT",
        "MODIFY_CHARACTERISTIC_CHARACTERISTIC",
        "MODIFY_CHARACTERISTIC_OPERATION",
        "MODIFY_CHARACTERISTIC_VALUE",
        "APPLY_CONTINUOUS_EFFECT_SUBJECT",
        "APPLY_CONTINUOUS_EFFECT_DURATION",
        "APPLY_CONTINUOUS_EFFECT_EFFECT",
        "SEARCH_ZONE_SEARCHER",
        "SEARCH_ZONE_ZONE",
        "SEARCH_ZONE_SELECTION",
        "SEARCH_ZONE_DESTINATION",
        "SEARCH_ZONE_REVEAL",
        "DEAL_DAMAGE_SOURCE",
        "DEAL_DAMAGE_RECIPIENT",
        "DEAL_DAMAGE_AMOUNT",
        "CREATE_DELAYED_EFFECT_DELAY",
        "CREATE_DELAYED_EFFECT_EFFECT",
        "TRIGGER_FROM_EVENT_EVENT",
        "TRIGGER_FROM_EVENT_CONTROLLER",
        "TRIGGER_FROM_EVENT_CONDITION",
        "REPLACE_EVENT_EVENT",
        "REPLACE_EVENT_REPLACEMENT",
        "PAY_COST_PAYER",
        "PAY_COST_COST",
        "MODIFY_COST_SUBJECT",
        "MODIFY_COST_COST",
        "MODIFY_COST_OPERATION",
        "CHOOSE_MODE_CHOOSER",
        "CHOOSE_MODE_MINIMUM",
        "CHOOSE_MODE_MAXIMUM",
        "CONDITIONAL_EFFECT_CONDITION",
        "CONDITIONAL_EFFECT_THEN_EFFECT",
        "CONDITIONAL_EFFECT_ELSE_EFFECT",
        "KEYWORD_REFERENCE_EXPANSION"
      ]
    },
    "dimension_kind": {
      "type": "string",
      "enum": [
        "ENTITY_REF",
        "QUANTITY",
        "ZONE_REF",
        "CHARACTERISTIC_REF",
        "PARAMETER_VALUE",
        "SEMANTIC_DESCRIPTOR",
        "DURATION",
        "M2_ENUM",
        "BOOLEAN",
        "RELATIONSHIP_ORDINAL"
      ]
    },
    "domain_kind": {
      "type": "string",
      "enum": [
        "ANY_TYPED_VALUE",
        "M2_ENUM_SUBSET",
        "M2_SHAPE_SUBSET"
      ]
    },
    "semantic_shape": {
      "type": "string",
      "enum": [
        "event",
        "condition",
        "restriction",
        "effect",
        "replacement",
        "duration",
        "cost",
        "alternative",
        "unknown"
      ]
    },
    "dimension_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "allowed_enum_values",
        "allowed_shapes"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/domain_kind"
        },
        "allowed_enum_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "allowed_shapes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semantic_shape"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "ANY_TYPED_VALUE"
            },
            "allowed_enum_values": {
              "const": []
            },
            "allowed_shapes": {
              "const": []
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "M2_ENUM_SUBSET"
            },
            "allowed_shapes": {
              "const": []
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "M2_SHAPE_SUBSET"
            },
            "allowed_enum_values": {
              "const": []
            }
          }
        }
      ]
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_key",
        "dimension_kind",
        "required",
        "domain",
        "unknown_policy"
      ],
      "properties": {
        "path_key": {
          "$ref": "#/$defs/path_key"
        },
        "dimension_kind": {
          "$ref": "#/$defs/dimension_kind"
        },
        "required": {
          "type": "boolean"
        },
        "domain": {
          "$ref": "#/$defs/dimension_domain"
        },
        "unknown_policy": {
          "const": "EXPLICIT_BUT_NOT_ACTIVE"
        }
      }
    },
    "exclusion_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "excluded_enum_values",
        "excluded_shapes"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/domain_kind"
        },
        "excluded_enum_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "excluded_shapes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semantic_shape"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "ANY_TYPED_VALUE"
            },
            "excluded_enum_values": {
              "const": []
            },
            "excluded_shapes": {
              "const": []
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "M2_ENUM_SUBSET"
            },
            "excluded_shapes": {
              "const": []
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "M2_SHAPE_SUBSET"
            },
            "excluded_enum_values": {
              "const": []
            }
          }
        }
      ]
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_key",
        "domain"
      ],
      "properties": {
        "path_key": {
          "$ref": "#/$defs/path_key"
        },
        "domain": {
          "$ref": "#/$defs/exclusion_domain"
        }
      }
    },
    "capability_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_family_id",
        "capability_version",
        "claim_digest"
      ],
      "properties": {
        "capability_family_id": {
          "type": "string",
          "pattern": "^capfam_[0-9a-f]{64}$"
        },
        "capability_version": {
          "$ref": "#/$defs/positive_integer"
        },
        "claim_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "composition_component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_key",
        "capability",
        "required",
        "ordinal"
      ],
      "properties": {
        "component_key": {
          "$ref": "#/$defs/text"
        },
        "capability": {
          "$ref": "#/$defs/capability_ref"
        },
        "required": {
          "type": "boolean"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/composition_component"
          }
        }
      }
    }
  }
}
